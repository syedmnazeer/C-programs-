#include <stdio.h>

// Call by Value (no real change)
void swapByValue(int a, int b)
{
    int temp = a;
    a = b;
    b = temp;

    printf("Inside swapByValue: %d %d\n", a, b);
}

// Call by Reference (real change)
void swapByReference(int *a, int *b)
{
    int temp = *a;
    *a = *b;
    *b = temp;

    printf("Inside swapByReference: %d %d\n", *a, *b);
}

int main()
{
    int x, y;

    printf("Enter two numbers: ");
    scanf("%d %d", &x, &y);

    swapByValue(x, y);
    printf("After call by value: %d %d\n", x, y);

    swapByReference(&x, &y);
    printf("After call by reference: %d %d\n", x, y);

    return 0;
}
