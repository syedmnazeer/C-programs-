#include <stdio.h>
#include <math.h>

int main()
{
    float x1, y1, x2, y2;
    float dx, dy, distance;

    printf("Enter x1 and y1: ");
    scanf("%f %f", &x1, &y1);

    printf("Enter x2 and y2: ");
    scanf("%f %f", &x2, &y2);

    dx = x2 - x1;
    dy = y2 - y1;

    distance = sqrt(dx*dx + dy*dy);

    printf("Distance between the two points = %.2f\n", distance);

    return 0;
}
